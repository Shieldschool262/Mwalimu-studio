# ---------------------------------------------------------------------------
# OPTIONAL. Everything here can also be set from the in-app Settings page.
# Settings are saved to backend/settings.json (gitignored) and take priority;
# these environment variables are the fallback for headless / scripted setups.
#
# Pick ONE AI provider and ONE web search provider on the Settings page.
# Recommended free combo: Gemini (gemini-3.5-flash-lite) + DuckDuckGo HTML (no key).
# ---------------------------------------------------------------------------

# Google Gemini - https://aistudio.google.com/apikey
# Use a Flash-Lite model; gemini-3.8-flash is often overloaded on the free tier.
GEMINI_API_KEY=

# Alternatives (set only the one you choose)
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Web search (optional - DuckDuckGo needs no key at all)
TAVILY_API_KEY=
SERPER_API_KEY=
